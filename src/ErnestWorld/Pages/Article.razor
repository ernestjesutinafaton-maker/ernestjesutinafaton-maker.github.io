@page "/journal/{Slug}"
@implements IAsyncDisposable
@inject BlogService Blog
@inject GameState Game
@inject BrowserService Browser
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>@(_post?.Meta.Title ?? T("Article", "Article")) · @T("Le Journal d'Ernest", "Ernest's Journal")</PageTitle>

<div class="overlay">
    <div class="read-progress" aria-hidden="true"><span @ref="_bar"></span></div>

    <div class="overlay-scroll" @ref="_scroller">
        <div class="overlay-inner article-wrap">
            <nav class="overlay-bar" aria-label="@T("Navigation de l'article", "Article navigation")">
                <a class="back" href="journal"><Icon Name="arrow-left" Size="16" /> @T("Le Journal", "The Journal")</a>
                <a class="back" href="jeu/?lieu=scriptorium">@T("Retour à l'île", "Back to the island")</a>
            </nav>

            @if (_loading)
            {
                <p class="loading">@T("Ouverture du parchemin…", "Unrolling the scroll…")</p>
            }
            else if (_post is null)
            {
                <div class="lost">
                    <h1>@T("Cet article n'existe pas", "This article doesn't exist")</h1>
                    <p>@T("Il a peut-être changé de nom. Les autres sont dans le Journal.", "It may have been renamed. The others are in the Journal.")</p>
                    <a class="link-btn primary" href="journal">@T("Ouvrir le Journal", "Open the Journal")</a>
                </div>
            }
            else
            {
                var meta = _post.Meta;
                var read = Game.HasRead(meta.Slug);

                <article class="article" lang="fr">
                    <header class="article-head">
                        <p class="overlay-kicker">@string.Join(" · ", meta.Tags)</p>
                        <h1>@meta.Title</h1>
                        <p class="article-meta" lang="@LanguageService.Code(Language)">
                            <span>@Dates.Format(meta.Date, Language)</span>
                            <span>@T($"{meta.ReadingMinutes} min de lecture", $"{meta.ReadingMinutes} min read")</span>
                            @if (read)
                            {
                                <span class="tag tag-live"><Icon Name="check" Size="12" /> @T("Lu", "Read")</span>
                            }
                            else
                            {
                                <span class="tag tag-gold">@T($"+{Rules.XpPerPost} XP à la fin", $"+{Rules.XpPerPost} XP at the end")</span>
                            }
                        </p>
                        @if (En)
                        {
                            <p class="lang-note" lang="en">
                                <Icon Name="page" Size="16" />
                                <span>This article is written in French. Your browser can translate it for you (right-click, then “Translate to English”).</span>
                            </p>
                        }
                    </header>

                    <div class="prose">@((MarkupString)_post.Html)</div>

                    <footer class="article-end" lang="@LanguageService.Code(Language)">
                        <div class="end-badge @(read ? "is-done" : null)">
                            <Icon Name="@(read ? "check" : "page")" Size="20" />
                            <span>@(read
                                ? T($"Article lu · +{Rules.XpPerPost} XP gagnés", $"Article read · +{Rules.XpPerPost} XP earned")
                                : T("Encore quelques lignes pour gagner l'XP…", "A few more lines to earn the XP…"))</span>
                        </div>

                        <section class="journal-newsletter is-inline" aria-labelledby="article-newsletter">
                            <h2 id="article-newsletter">@T("Tu veux la suite ?", "Want more?")</h2>
                            <NewsletterForm Compact />
                        </section>

                        <nav class="article-nav" aria-label="@T("Autres articles", "Other articles")">
                            @if (_newer is not null)
                            {
                                <a href="journal/@_newer.Slug"><small>@T("Plus récent", "Newer")</small><span lang="fr">@_newer.Title</span></a>
                            }
                            @if (_older is not null)
                            {
                                <a href="journal/@_older.Slug" class="is-older"><small>@T("Plus ancien", "Older")</small><span lang="fr">@_older.Title</span></a>
                            }
                        </nav>
                    </footer>
                </article>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private ElementReference _scroller;
    private ElementReference _bar;
    private DotNetObjectReference<Article>? _self;
    private IJSObjectReference? _watch;

    private Post? _post;
    private PostMeta? _newer, _older;
    private bool _loading = true;
    private string? _loadedSlug;
    private bool _needsWatch;

    protected override void OnInitialized() => Game.Changed += Refresh;

    protected override async Task OnParametersSetAsync()
    {
        if (Slug == _loadedSlug)
        {
            return;
        }

        _loadedSlug = Slug;
        _loading = true;
        await StopWatchingAsync();

        _post = await Blog.GetPostAsync(Slug);
        (_newer, _older) = await Blog.GetNeighboursAsync(Slug);
        _loading = false;
        _needsWatch = _post is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_needsWatch)
        {
            return;
        }

        _needsWatch = false;
        await Browser.ScrollToTopAsync(_scroller);
        _self ??= DotNetObjectReference.Create(this);
        _watch = await Browser.WatchReadingAsync(_scroller, _bar, _self);
    }

    /// <summary>Appelé par le JavaScript quand l'article a été lu jusqu'au bout.</summary>
    [JSInvokable]
    public Task OnReadComplete() => InvokeAsync(async () =>
    {
        if (_post is null)
        {
            return;
        }

        if (await Game.MarkReadAsync(_post.Meta.Slug))
        {
            Toasts.Show(T("Article lu", "Article read"), $"{_post.Meta.Title} · +{Rules.XpPerPost} XP", "page");
        }
    });

    private async Task StopWatchingAsync()
    {
        if (_watch is null)
        {
            return;
        }

        try
        {
            await _watch.InvokeVoidAsync("dispose");
            await _watch.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }

        _watch = null;
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Game.Changed -= Refresh;
        await StopWatchingAsync();
        _self?.Dispose();
    }
}
