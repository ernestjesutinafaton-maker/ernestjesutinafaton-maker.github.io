@page "/journal"
@implements IDisposable
@inject BlogService Blog
@inject GameState Game
@inject NavigationManager Nav

<PageTitle>Le Journal d'Ernest · Blog</PageTitle>

<div class="overlay">
    <div class="overlay-scroll">
        <div class="overlay-inner">
            <nav class="overlay-bar" aria-label="Navigation du Journal">
                <a class="back" href="@($"{Nav.BaseUri}?lieu=scriptorium")"><Icon Name="arrow-left" Size="16" /> Retour à l'île</a>
                <a class="back" href="rss.xml" target="_blank" rel="noopener"><Icon Name="rss" Size="16" /> RSS</a>
            </nav>

            <header class="journal-head">
                <p class="overlay-kicker">Le Scriptorium · Blog</p>
                <h1>Le Journal d'Ernest</h1>
                <p class="journal-lead">
                    Ce que je construis, ce que j'apprends, ce que j'aime.
                    Chaque article lu jusqu'au bout rapporte <strong>+@Rules.XpPerPost XP</strong> sur l'île.
                </p>
                @if (_posts is { Count: > 0 })
                {
                    <div class="journal-progress">
                        <div class="xp is-large"><div class="xp-fill" style="width: @ReadPercent%"></div></div>
                        <span>@ReadCount / @_posts.Count articles lus</span>
                    </div>
                }
            </header>

            @if (_posts is null)
            {
                <p class="loading">Ouverture des parchemins…</p>
            }
            else if (_posts.Count == 0)
            {
                <p class="empty">Les premiers articles arrivent bientôt. Abonne-toi pour ne pas les rater !</p>
            }
            else
            {
                @if (_tags.Count > 1)
                {
                    <div class="filters" role="group" aria-label="Filtrer par thème">
                        <button type="button" class="filter @(_tag is null ? "is-active" : null)" aria-pressed="@(_tag is null ? "true" : "false")" @onclick="() => _tag = null">Tous</button>
                        @foreach (var tag in _tags)
                        {
                            <button type="button" class="filter @(_tag == tag ? "is-active" : null)" aria-pressed="@(_tag == tag ? "true" : "false")" @onclick="() => _tag = tag">@tag</button>
                        }
                    </div>
                }

                <div class="post-grid">
                    @foreach (var post in _posts.Where(p => _tag is null || p.Tags.Contains(_tag)))
                    {
                        <ArticleCard @key="post.Slug" Post="post" />
                    }
                </div>
            }

            <section class="journal-newsletter" aria-labelledby="newsletter-title">
                <div>
                    <p class="overlay-kicker">Le Pigeonnier</p>
                    <h2 id="newsletter-title">Reçois les prochains articles</h2>
                </div>
                <NewsletterForm />
            </section>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<PostMeta>? _posts;
    private List<string> _tags = [];
    private string? _tag;

    private int ReadCount => _posts?.Count(p => Game.HasRead(p.Slug)) ?? 0;
    private int ReadPercent => _posts is { Count: > 0 } ? ReadCount * 100 / _posts.Count : 0;

    protected override async Task OnInitializedAsync()
    {
        Game.Changed += Refresh;
        _posts = await Blog.GetPostsAsync();
        _tags = _posts.SelectMany(p => p.Tags).Distinct().Order().ToList();
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Game.Changed -= Refresh;
}
