@page "/journal"
@implements IDisposable
@inject BlogService Blog
@inject GameState Game
@inject NavigationManager Nav

<PageTitle>@T("Le Journal d'Ernest · Blog", "Ernest's Journal · Blog")</PageTitle>

<div class="overlay">
    <div class="overlay-scroll">
        <div class="overlay-inner">
            <nav class="overlay-bar" aria-label="@T("Navigation du Journal", "Journal navigation")">
                <a class="back" href="jeu/?lieu=scriptorium"><Icon Name="arrow-left" Size="16" /> @T("Retour à l'île", "Back to the island")</a>
                <a class="back" href="./" target="_top">@T("Portfolio", "Portfolio")</a>
                <a class="back" href="rss.xml" target="_blank" rel="noopener"><Icon Name="rss" Size="16" /> RSS</a>
            </nav>

            <header class="journal-head">
                <p class="overlay-kicker">@T("Le Scriptorium · Blog", "The Scriptorium · Blog")</p>
                <h1>@T("Le Journal d'Ernest", "Ernest's Journal")</h1>
                <p class="journal-lead">
                    @T("Ce que je construis, ce que j'apprends, ce que j'aime. Chaque article lu jusqu'au bout rapporte",
                        "What I build, what I learn, what I love. Each article read to the end earns")
                    <strong>+@Rules.XpPerPost XP</strong> @T("sur l'île.", "on the island.")
                </p>
                @if (En)
                {
                    <p class="lang-note">
                        <Icon Name="page" Size="16" />
                        <span>The articles are written in French. Your browser can translate them for you (right-click, then “Translate to English”).</span>
                    </p>
                }
                @if (_posts is { Count: > 0 })
                {
                    <div class="journal-progress">
                        <div class="xp is-large"><div class="xp-fill" style="width: @ReadPercent%"></div></div>
                        <span>@ReadCount / @_posts.Count @T("articles lus", "articles read")</span>
                    </div>
                }
            </header>

            @if (_posts is null)
            {
                <p class="loading">@T("Ouverture des parchemins…", "Unrolling the scrolls…")</p>
            }
            else if (_posts.Count == 0)
            {
                <p class="empty">@T("Les premiers articles arrivent bientôt. Abonne-toi pour ne pas les rater !", "The first articles are coming soon. Subscribe so you don't miss them!")</p>
            }
            else
            {
                @if (_tags.Count > 1)
                {
                    <div class="filters" role="group" aria-label="@T("Filtrer par thème", "Filter by topic")">
                        <button type="button" class="filter @(_tag is null ? "is-active" : null)" aria-pressed="@(_tag is null ? "true" : "false")" @onclick="() => _tag = null">@T("Tous", "All")</button>
                        @foreach (var tag in _tags)
                        {
                            <button type="button" class="filter @(_tag == tag ? "is-active" : null)" aria-pressed="@(_tag == tag ? "true" : "false")" @onclick="() => _tag = tag">@tag</button>
                        }
                    </div>
                }

                <div class="post-grid">
                    @foreach (var post in _posts.Where(p => _tag is null || p.Tags.Contains(_tag)))
                    {
                        <ArticleCard @key="post.Slug" Post="post" />
                    }
                </div>
            }

            <section class="journal-newsletter" aria-labelledby="newsletter-title">
                <div>
                    <p class="overlay-kicker">@T("Le Pigeonnier", "The Dovecote")</p>
                    <h2 id="newsletter-title">@T("Reçois les prochains articles", "Get the next articles")</h2>
                </div>
                <NewsletterForm />
            </section>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<PostMeta>? _posts;
    private List<string> _tags = [];
    private string? _tag;

    private int ReadCount => _posts?.Count(p => Game.HasRead(p.Slug)) ?? 0;
    private int ReadPercent => _posts is { Count: > 0 } ? ReadCount * 100 / _posts.Count : 0;

    protected override async Task OnInitializedAsync()
    {
        Game.Changed += Refresh;
        _posts = await Blog.GetPostsAsync();
        _tags = _posts.SelectMany(p => p.Tags).Distinct().Order().ToList();
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Game.Changed -= Refresh;
}
