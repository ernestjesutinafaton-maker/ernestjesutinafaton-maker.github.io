@implements IDisposable
@inject GameState Game

<div class="dialog-backdrop" @onclick="OnClose">
    <div class="dialog is-wide" role="dialog" aria-modal="true" aria-labelledby="levels-title" @onclick:stopPropagation="true">
        <header class="panel-head">
            <div>
                <p class="panel-kicker">Campagne · @Game.DefeatedCount / @Campaign.Levels.Count boss vaincus</p>
                <h2 id="levels-title">Carte des niveaux</h2>
            </div>
            <button type="button" class="panel-close" @onclick="OnClose" aria-label="Fermer">
                <Icon Name="close" />
            </button>
        </header>

        <div class="panel-body">
            <ol class="levels">
                @foreach (var level in Campaign.Levels)
                {
                    var state = Campaign.StateOf(level, Game);
                    <li class="level is-@state.ToString().ToLowerInvariant()">
                        <div class="level-num" aria-hidden="true">
                            @if (state == LevelState.Completed)
                            {
                                <Icon Name="check" Size="20" />
                            }
                            else if (state == LevelState.Locked)
                            {
                                <Icon Name="lock" Size="18" />
                            }
                            else
                            {
                                @level.Number
                            }
                        </div>

                        <div class="level-main">
                            <h3>
                                Niveau @level.Number · @level.Name
                                <span class="tag @StateClass(state)">@StateLabel(state)</span>
                            </h3>
                            <p>@level.Story</p>

                            @if (state != LevelState.Locked)
                            {
                                <ul class="objectives">
                                    @foreach (var objective in level.Objectives)
                                    {
                                        var done = objective.IsDone(Game);
                                        <li class="@(done ? "is-done" : null)">
                                            @if (objective.PlaceId is { } placeId && !done)
                                            {
                                                <button type="button" @onclick="() => OnGoto.InvokeAsync(placeId)">
                                                    <Icon Name="flag" Size="14" /> @objective.Label
                                                </button>
                                            }
                                            else if (objective.Href is { } href && !done)
                                            {
                                                <a href="@href"><Icon Name="flag" Size="14" /> @objective.Label</a>
                                            }
                                            else
                                            {
                                                <span><Icon Name="@(done ? "check" : "flag")" Size="14" /> @objective.Label</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }

                            <div class="level-boss">
                                <span class="boss-row-icon"><Icon Name="@Campaign.IconOf(level.BossId)" Size="18" /></span>
                                <div>
                                    <p class="boss-row-name">@level.Boss.Name</p>
                                    <p class="small-print">@level.Boss.MaxHp PV · +@level.Boss.XpReward XP@(level.Boss.TwoPhases ? " · deux phases" : "")</p>
                                </div>
                                @switch (state)
                                {
                                    case LevelState.BossReady:
                                        <button type="button" class="btn-boss" @onclick="() => OnFight.InvokeAsync(level.BossId)">
                                            <Icon Name="sword" Size="16" /> Affronter
                                        </button>
                                        break;
                                    case LevelState.Completed:
                                        <button type="button" class="link-btn" @onclick="() => OnFight.InvokeAsync(level.BossId)">Revanche</button>
                                        break;
                                    case LevelState.InProgress:
                                        <span class="boss-row-lock">Endormi</span>
                                        break;
                                    default:
                                        <span class="boss-row-lock">Verrouillé</span>
                                        break;
                                }
                            </div>
                        </div>
                    </li>
                }
            </ol>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnFight { get; set; }
    [Parameter] public EventCallback<string> OnGoto { get; set; }

    private static string StateLabel(LevelState state) => state switch
    {
        LevelState.Completed => "Terminé",
        LevelState.BossReady => "Boss réveillé",
        LevelState.InProgress => "En cours",
        _ => "Verrouillé",
    };

    private static string StateClass(LevelState state) => state switch
    {
        LevelState.Completed => "tag-live",
        LevelState.BossReady => "tag-danger",
        LevelState.InProgress => "tag-gold",
        _ => "",
    };

    protected override void OnInitialized() => Game.Changed += Refresh;
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Game.Changed -= Refresh;
}
