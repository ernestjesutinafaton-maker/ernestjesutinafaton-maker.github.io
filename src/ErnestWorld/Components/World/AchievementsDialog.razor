@implements IDisposable
@inject GameState Game
@inject WorldService World

@{
    var level = Game.Level;
    var percent = (int)Math.Round(level.Progress(Game.Xp) * 100);
}

<div class="dialog-backdrop" @onclick="OnClose">
    <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="achievements-title" @onclick:stopPropagation="true">
        <header class="panel-head">
            <div>
                <p class="panel-kicker">Salle des trophées</p>
                <h2 id="achievements-title">Tes succès</h2>
            </div>
            <button type="button" class="panel-close" @onclick="OnClose" aria-label="Fermer">
                <Icon Name="close" />
            </button>
        </header>

        <div class="panel-body">
            <div class="level-card">
                <div class="level-badge">@level.Number</div>
                <div class="level-info">
                    <p class="level-title">Rang @level.Number · @level.Title</p>
                    <div class="xp is-large" role="progressbar" aria-label="Progression vers le rang suivant"
                         aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent">
                        <div class="xp-fill" style="width: @percent%"></div>
                    </div>
                    <p class="xp-text">@Game.Xp XP@(level.NextXp is int next ? $" · encore {next - Game.Xp} XP avant le rang {level.Number + 1}" : " · rang maximum atteint")</p>
                    <p class="xp-text">Au combat : @Rules.BattleStats(level.Number).Hearts cœurs et @Rules.BattleStats(level.Number).Hints indices</p>
                </div>
            </div>

            <ul class="achievements">
                @foreach (var achievement in Rules.Achievements)
                {
                    var unlocked = Game.IsUnlocked(achievement.Id);
                    <li class="achievement @(unlocked ? "is-unlocked" : null)">
                        <span class="achievement-icon"><Icon Name="@(unlocked ? achievement.Icon : "lock")" Size="20" /></span>
                        <div>
                            <h3>@achievement.Name</h3>
                            <p>@achievement.Description</p>
                        </div>
                        <span class="achievement-xp">+@Rules.XpPerAchievement XP</span>
                    </li>
                }
            </ul>

            <h3>Gagner de l'XP</h3>
            <ul class="list">
                <li>Vaincre un boss : <strong>de +@Bestiary.All.Min(b => b.XpReward) à +@Bestiary.All.Max(b => b.XpReward) XP</strong></li>
                <li>Découvrir un lieu de l'île : <strong>+@Rules.XpPerPlace XP</strong></li>
                <li>Lire un article du Journal jusqu'au bout : <strong>+@Rules.XpPerPost XP</strong></li>
                <li>S'abonner à la newsletter : <strong>+@Rules.XpSubscribe XP</strong></li>
                <li>Suivre toute la visite guidée : <strong>+@Rules.XpTour XP</strong></li>
                <li>Chaque succès débloqué : <strong>+@Rules.XpPerAchievement XP</strong></li>
            </ul>

            <p class="small-print">Monter en rang donne plus de cœurs et d'indices pour les combats de boss. Ta progression est enregistrée dans ce navigateur uniquement.</p>
            <button type="button" class="link-btn danger" @onclick="ResetAsync">
                @(_confirmReset ? "Confirmer : tout effacer ?" : "Recommencer l'aventure")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private bool _confirmReset;

    protected override void OnInitialized() => Game.Changed += Refresh;

    private async Task ResetAsync()
    {
        if (!_confirmReset)
        {
            _confirmReset = true;
            return;
        }

        _confirmReset = false;
        await Game.ResetAsync();
        await World.SetVisitedAsync(Game.Visited);
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Game.Changed -= Refresh;
}
