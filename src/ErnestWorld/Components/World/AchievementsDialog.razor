@implements IDisposable
@inject GameState Game
@inject WorldService World

@{
    var level = Game.Level;
    var percent = (int)Math.Round(level.Progress(Game.Xp) * 100);
    var stats = Rules.BattleStats(level.Number);
}

<div class="dialog-backdrop" @onclick="OnClose">
    <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="achievements-title" @onclick:stopPropagation="true">
        <header class="panel-head">
            <div>
                <p class="panel-kicker">@T("Salle des trophées", "Trophy room")</p>
                <h2 id="achievements-title">@T("Tes succès", "Your achievements")</h2>
            </div>
            <button type="button" class="panel-close" @onclick="OnClose" aria-label="@T("Fermer", "Close")">
                <Icon Name="close" />
            </button>
        </header>

        <div class="panel-body">
            <div class="level-card">
                <div class="level-badge">@level.Number</div>
                <div class="level-info">
                    <p class="level-title">@T("Rang", "Rank") @level.Number · @T(level.Title)</p>
                    <div class="xp is-large" role="progressbar" aria-label="@T("Progression vers le rang suivant", "Progress to the next rank")"
                         aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent">
                        <div class="xp-fill" style="width: @percent%"></div>
                    </div>
                    <p class="xp-text">
                        @Game.Xp XP@(level.NextXp is int next
                            ? T($" · encore {next - Game.Xp} XP avant le rang {level.Number + 1}", $" · {next - Game.Xp} more XP to rank {level.Number + 1}")
                            : T(" · rang maximum atteint", " · max rank reached"))
                    </p>
                    <p class="xp-text">@T($"Au combat : {stats.Hearts} cœurs et {stats.Hints} indices", $"In battle: {stats.Hearts} hearts and {stats.Hints} hints")</p>
                </div>
            </div>

            <ul class="achievements">
                @foreach (var achievement in Rules.Achievements)
                {
                    var unlocked = Game.IsUnlocked(achievement.Id);
                    <li class="achievement @(unlocked ? "is-unlocked" : null)">
                        <span class="achievement-icon"><Icon Name="@(unlocked ? achievement.Icon : "lock")" Size="20" /></span>
                        <div>
                            <h3>@T(achievement.Name)</h3>
                            <p>@T(achievement.Description)</p>
                        </div>
                        <span class="achievement-xp">+@Rules.XpPerAchievement XP</span>
                    </li>
                }
            </ul>

            <h3>@T("Gagner de l'XP", "Earning XP")</h3>
            <ul class="list">
                <li>@T("Vaincre un boss :", "Defeat a boss:") <strong>@T($"de +{Bestiary.All.Min(b => b.XpReward)} à +{Bestiary.All.Max(b => b.XpReward)} XP", $"+{Bestiary.All.Min(b => b.XpReward)} to +{Bestiary.All.Max(b => b.XpReward)} XP")</strong></li>
                <li>@T("Découvrir un lieu de l'île :", "Discover a place on the island:") <strong>+@Rules.XpPerPlace XP</strong></li>
                <li>@T("Lire un article du Journal jusqu'au bout :", "Read a Journal article to the end:") <strong>+@Rules.XpPerPost XP</strong></li>
                <li>@T("S'abonner à la newsletter :", "Subscribe to the newsletter:") <strong>+@Rules.XpSubscribe XP</strong></li>
                <li>@T("Suivre toute la visite guidée :", "Follow the whole guided tour:") <strong>+@Rules.XpTour XP</strong></li>
                <li>@T("Chaque succès débloqué :", "Each achievement unlocked:") <strong>+@Rules.XpPerAchievement XP</strong></li>
            </ul>

            <p class="small-print">
                @T("Monter en rang donne plus de cœurs et d'indices pour les combats de boss. Ta progression est enregistrée dans ce navigateur uniquement.",
                    "Ranking up gives you more hearts and hints for boss battles. Your progress is saved in this browser only.")
            </p>
            <button type="button" class="link-btn danger" @onclick="ResetAsync">
                @(_confirmReset ? T("Confirmer : tout effacer ?", "Confirm: erase everything?") : T("Recommencer l'aventure", "Restart the adventure"))
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private bool _confirmReset;

    protected override void OnInitialized() => Game.Changed += Refresh;

    private async Task ResetAsync()
    {
        if (!_confirmReset)
        {
            _confirmReset = true;
            return;
        }

        _confirmReset = false;
        await Game.ResetAsync();
        await World.SetVisitedAsync(Game.Visited);
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Game.Changed -= Refresh;
}
