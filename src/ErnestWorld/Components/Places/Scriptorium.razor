@implements IDisposable
@inject BlogService Blog
@inject GameState Game

<p class="lead">
    @T("Le Scriptorium abrite mon", "The Scriptorium is home to my") <strong>@T("Journal", "Journal")</strong>@T(" : ce que je construis, ce que j'apprends, ce que j'aime. Chaque article lu jusqu'au bout rapporte",
        ": what I build, what I learn, what I love. Each article read to the end earns")
    <strong>+@Rules.XpPerPost XP</strong>.
    @if (En)
    {
        <span>The articles are written in French.</span>
    }
</p>

@if (_posts is null)
{
    <p class="small-print">@T("Ouverture des parchemins…", "Unrolling the scrolls…")</p>
}
else if (_posts.Count == 0)
{
    <p>@T("Les premiers articles arrivent bientôt.", "The first articles are coming soon.")</p>
}
else
{
    <p class="small-print">@_posts.Count(p => Game.HasRead(p.Slug)) / @_posts.Count @T("articles lus", "articles read")</p>
    <div class="post-list">
        @foreach (var post in _posts.Take(3))
        {
            <ArticleCard Post="post" />
        }
    </div>
}

<div class="links">
    <a class="link-btn primary" href="journal"><Icon Name="book" Size="16" /> @T("Ouvrir le Journal", "Open the Journal")</a>
    <a class="link-btn" href="rss.xml" target="_blank" rel="noopener"><Icon Name="rss" Size="16" /> @T("Flux RSS", "RSS feed")</a>
</div>

@code {
    private IReadOnlyList<PostMeta>? _posts;

    protected override async Task OnInitializedAsync()
    {
        Game.Changed += Refresh;
        _posts = await Blog.GetPostsAsync();
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Game.Changed -= Refresh;
}
