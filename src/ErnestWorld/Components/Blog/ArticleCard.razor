@inject GameState Game

<a class="post-card @(Game.HasRead(Post.Slug) ? "is-read" : null)" href="journal/@Post.Slug">
    <div class="post-card-top">
        <span class="post-date">@FrenchDate.Format(Post.Date)</span>
        @if (Game.HasRead(Post.Slug))
        {
            <span class="tag tag-live"><Icon Name="check" Size="12" /> Lu</span>
        }
        else
        {
            <span class="tag tag-gold">+@Rules.XpPerPost XP</span>
        }
    </div>
    <h3>@Post.Title</h3>
    <p>@Post.Summary</p>
    <div class="post-card-foot">
        <span class="post-tags">@string.Join(" · ", Post.Tags)</span>
        <span>@Post.ReadingMinutes min de lecture</span>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public PostMeta Post { get; set; } = default!;
}
