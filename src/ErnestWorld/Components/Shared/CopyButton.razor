@inject BrowserService Browser

<button type="button" class="copy" @onclick="CopyAsync">
    <span>@Text</span>
    <span aria-live="polite">@(_result switch { true => T("Copié !", "Copied!"), false => T("Copie impossible", "Can't copy"), _ => T("Copier", "Copy") })</span>
</button>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";

    // null : pas encore copié ; vrai / faux : résultat de la dernière copie.
    private bool? _result;

    private async Task CopyAsync()
    {
        _result = await Browser.CopyAsync(Text);
        StateHasChanged();
        await Task.Delay(2000);
        _result = null;
    }
}
